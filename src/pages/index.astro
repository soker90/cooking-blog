---
import { SITE } from '$/config'
import DefaultPageLayout from '$/layouts/default.astro'
import PostPreviewList from '$/components/PostPreviewList.astro'

const title = 'Inicio'
const description = 'Mis recetas'

const posts = Object.values(import.meta.glob('./blog/*.md', { eager: true }))
const sortedPosts = posts.sort((a, b) => new Date(b.frontmatter.date) - new Date(a.frontmatter.date))
const recipeListSchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sortedPosts.map((post, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        url: new URL(post.url, SITE.url).href
    }))
}
---
<DefaultPageLayout content={{ title, description }} showPageHeader={false}>
    <h1 class="sr-only">{title}</h1>
    <script type="application/ld+json" set:html={JSON.stringify(recipeListSchema).replace(/</g, '\u003c')} />
    <PostPreviewList posts={sortedPosts} />
    <div class="page__actions">
        <a class="action__go-to-blog" href="/blog" title="Todas">Todas &rarr;</a>
    </div>
</DefaultPageLayout>

<style>
    @reference "../styles/global.css";
    .page__actions {
        @apply flex justify-center md:justify-end py-6
    }
    .action__go-to-blog {
        @apply text-base uppercase text-gray-500 dark:text-gray-400 hover:underline
    }
</style>
