---
import type { MarkdownInstance } from 'astro'
import { getSlugFromPathname } from '$/utils'

import PostDraftPageLayout from '$/layouts/post-draft.astro'

export async function getStaticPaths({ }) {
    const allPosts = Object.values(import.meta.glob<MarkdownInstance<Record<string, unknown>>>('../*.md', { eager: true }))
    const allSlugs = new Set()
    const allPostsWithSlug = allPosts.map(post => {
        const slug = getSlugFromPathname(post.file).toLowerCase()
        allSlugs.add(slug)
        return {
            ...post,
            slug
        }
    })

    return Array.from(allSlugs).map((slug) => {
        const filteredPosts = allPostsWithSlug.filter((post) => post.slug === slug )
        return {
            params: { slug },
            props: {
                pages: filteredPosts
            }
        };
    });
}

const { slug } = Astro.params
const { pages } = Astro.props
const [ post ] = pages
---
<PostDraftPageLayout content={{ ...post.frontmatter, slug }}>
    <post.Content/>
</PostDraftPageLayout>
