---
const { page } = Astro.props
---
<nav class="page__actions" aria-label="Paginación">
    {page.url.prev && <a class="action__go-to-x" href={page.url.prev} aria-label="Página anterior">&larr; Anterior</a>}
    {page.url.next && <a class="action__go-to-x" href={page.url.next} aria-label="Página siguiente">Siguiente &rarr;</a>}
</nav>
<style>
    @reference "../styles/global.css";
    .page__actions {
        @apply flex justify-center md:justify-end py-6 gap-2
    }
    .action__go-to-x {
        @apply text-base uppercase text-gray-500 dark:text-gray-400 hover:underline
    }
</style>
