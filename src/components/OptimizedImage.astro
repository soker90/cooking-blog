---
import fs from 'node:fs'
import path from 'node:path'
import sharp from 'sharp'

export type Props = {
    src: string
    alt: string
    fetchpriority?: 'high' | 'low' | 'auto'
}

const { src, alt, fetchpriority } = Astro.props
const optimizable = /^\/images\/uploads\/[^/]+\.jpe?g$/i.test(src)
const filename = src.split('/').pop() ?? ''
const base = filename.replace(/\.jpe?g$/i, '')
const optimizedBase = `/images/optimized/${base}`

const imagePath = path.join(process.cwd(), 'public', src.replace(/^\//, ''))
const metadata = fs.existsSync(imagePath) ? await sharp(imagePath).metadata() : {}
const width = metadata.width
const height = metadata.height
const responsiveWidths = width
    ? [640, 1024, 1600]
        .filter(candidate => candidate < width)
        .concat(width <= 1600 ? [width] : [])
        .sort((a, b) => a - b)
    : []
const hasOptimizedVariants = optimizable && responsiveWidths.length > 0
const avifSrcset = responsiveWidths.map(candidate => `${optimizedBase}-${candidate}.avif ${candidate}w`).join(', ')
const webpSrcset = responsiveWidths.map(candidate => `${optimizedBase}-${candidate}.webp ${candidate}w`).join(', ')
const sizes = '(min-width: 1024px) 1024px, calc(100vw - 2rem)'
---
{hasOptimizedVariants ? (
    <picture>
        <source srcset={avifSrcset} sizes={sizes} type="image/avif" />
        <source srcset={webpSrcset} sizes={sizes} type="image/webp" />
        <img src={src} alt={alt} width={width} height={height} sizes={sizes} decoding="async" fetchpriority={fetchpriority} />
    </picture>
) : (
    <img src={src} alt={alt} width={width} height={height} decoding="async" fetchpriority={fetchpriority} />
)}
